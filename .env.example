# Exemplo de configuração para INSTALAÇÃO COM DADOS REAIS.
#
# Copie para .env e preencha. Este arquivo declara TODAS as variáveis que o
# código lê — se alguma some daqui, ou aparece uma que o código ignora, o teste
# `src/tests/unit/test_config_guarda.py` derruba a suíte. Variável morta em
# arquivo de exemplo é ativamente enganosa: faz alguém "conferir se o modo X
# está desligado" e receber falsa confirmação.

# ---------------------------------------------------------------- Segurança

# OBRIGATÓRIA com APP_ENV=prod: sem ela as sessões morrem a cada deploy e a
# autenticação quebra EM SILÊNCIO com mais de um worker (válida num, inválida
# no outro). Deixada VAZIA de propósito — valor de exemplo num repositório
# público é pior que variável ausente: o fallback gera chave aleatória, o
# placeholder daria uma chave de assinatura conhecida por qualquer um.
# Gere a sua:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# prod | dev. Fora de `dev` o cookie de sessão é emitido com `Secure` (default
# seguro) e o HSTS é enviado. Com `prod`, SECRET_KEY passa a ser obrigatória e
# o boot ABORTA sem ela.
APP_ENV=prod

# Senha inicial do administrador. Sem ela, o sistema gera uma ALEATÓRIA e a
# registra UMA VEZ no log do boot. Nunca mais `admin`: o default previsível
# abria janela entre o seed e o primeiro login legítimo.
ADMIN_INITIAL_PASSWORD=

# ------------------------------------------------------------------- Dados

DATABASE_URL=sqlite:///./instance/fluxo.db
# PostgreSQL (recomendado para instalação real — o SQLite acima serve a
# desenvolvimento e à demonstração):
# DATABASE_URL=postgresql://usuario:senha@host:porta/base

# Aplica as migrações Alembic no boot.
AUTO_MIGRATE=true

# Dados de EXEMPLO: limpa e repopula a cada boot. Numa instalação com dados
# reais isto apagaria a base — mantenha `false`.
SEED_DEMO_DATA=false

# Demonstração PÚBLICA: exibe as credenciais na tela de login, dispensa a troca
# de senha obrigatória e recusa a troca. NUNCA ligar com dados reais — o boot
# aborta se vier junto com SEED_DEMO_DATA=false ou APP_ENV=prod.
DEMO_MODE=false

# ---------------------------------------------------------------- Extração

# Raiz sob a qual todo caminho local de fonte de extração deve estar. Fora dela
# o cadastro é recusado — sem o confinamento, `diretorio=/etc` lia arquivo do
# servidor e devolvia o conteúdo no detalhe da execução.
EXTRACAO_PASTA_RAIZ=./instance/extracao

# Hosts internos autorizados para conectores de rede, separados por vírgula.
# Vazio = nenhum: loopback, faixas privadas e link-local (metadados de nuvem)
# são recusados. Extrair da intranet é caso de uso legítimo — declare aqui.
EXTRACAO_HOSTS_PERMITIDOS=

# Agendador de extração embutido. Roda no lifespan de CADA worker: com mais de
# um worker as fontes executariam N vezes (por isso o deploy usa --workers 1).
EXTRACAO_SCHEDULER=true

# Conector de demonstração (andaime de teste). Não ligar em instalação real.
EXTRACAO_DEMO_CONNECTOR=false

# ------------------------------------------------------------------ Sessão

# Expiração por INATIVIDADE, em segundos. Coexiste com o limite absoluto de
# expediente: o absoluto limita cookie roubado mantido ativo, este cobre a
# estação destravada.
SESSAO_INATIVIDADE_SEGUNDOS=3600

# Bloqueio de login após falhas consecutivas.
LOGIN_MAX_FALHAS=5
LOGIN_BLOQUEIO_SEGUNDOS=900
